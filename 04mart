Solution
A 'Dataset' can have a relation with multiple objects, such as an 
ItemRevision. Before you can delete a Dataset you must first delete the 
relations the Dataset has with other objects. The following code queries all 
'IMAN_specification' relations a Dataset has with an ItemRevision and then 
deletes these relations and finally, deletes the Dataset.

This code assumes you know how to get the Dataset and load the 
DataManagementService object.



public void deleteDataset()
{		
	ExpandGRMRelationsPref relationPref = new ExpandGRMRelationsPref();
	RelationAndTypesFilter2 typeFiler = new RelationAndTypesFilter2();
	
	relationPref.expItemRev = false;
	typeFiler.objectTypeNames = new String[]{ "ItemRevision" };
	typeFiler.relationName = "IMAN_specification";
	
	relationPref.info = new RelationAndTypesFilter2[]{ typeFiler };
	
	ExpandGRMRelationsResponse relationResp = 
dmService.expandGRMRelationsForSecondary(new ModelObject[]{ dataSet }, 
relationPref);
	
	if(!ServiceDataError(relationResp.serviceData))
	{
		for(ExpandGRMRelationsOutput grmRelations :
relationResp.output)
		{
			for(ExpandGRMRelationsData grmReationData :
grmRelations.otherSideObjData)
			{
				Relationship[] relationships = new 
Relationship[grmReationData.otherSideObjects.length];
				
				for(int ii = 0; ii <
grmReationData.otherSideObjects.length; ii++)
				{
					Relationship relationship = new
Relationship();
					relationship.primaryObject =
grmReationData.otherSideObjects[ii];
					relationship.secondaryObject = dataSet;
					relationship.relationType =
grmReationData.relationName;
					relationships[ii] = relationship;
				}
				
			       
ServiceDataError(dmService.deleteRelations(relationships));
			}
		}
		
		ServiceDataError(dmService.deleteObjects(new ModelObject[]{
dataSet }));
	}
