 * \return UID of the volume object
 */
public static String Get_Volume(Connection iConnection, String iVolume) throws Exception
{
    BusinessObjectQueryInput input = new BusinessObjectQueryInput();
    BusinessObjectQueryClause clause = new BusinessObjectQueryClause();
 
    clause.mathOperator = "=";
    clause.logicOperator = "";
    clause.propName = "volume_name";
    clause.propValue = iVolume;
 
    input.clientId = "TC_Integration";
    input.maxNumToReturn = 0;
    input.typeName = "ImanVolume";
    input.clauses = new BusinessObjectQueryClause[] { clause };
 
    SavedQueryService queryService = SavedQueryService.getService(iConnection);
 
    SavedQueriesResponse response = queryService.executeBusinessObjectQueries(new BusinessObjectQueryInput[] { input });
    ManageServiceData(response.serviceData);
 
 
    if (response.arrayOfResults.length != 1)
    { throw new Exception("Volume: " + iVolume + " not found. " + response.arrayOfResults.length); }
 
    QueryResults result = response.arrayOfResults[0];
    if (result.objectUIDS.length != 1)
    { throw new Exception("Volume: " + iVolume + " not found. " + result.objectUIDS.length); }
 
    return result.objectUIDS[0];
}

